# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL pública del sitio.
# - Local:      http://localhost:3000
# - Producción: el dominio real (ej. https://makicar.app)
# Imprescindible para que el magic link redirija correctamente tras el login.
# Debe coincidir con la Site URL en Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key — Supabase → Settings → API → service_role
# Necesaria para el panel /admin (creación de conductores). NUNCA exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe (Fase 5 — dejar vacío por ahora)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email / Resend (Fase 6 — dejar vacío por ahora)
